{
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true,
      "modules": true
    }
  },
  "extends": "airbnb",
  "rules": {
    "import/extensions": [2, "never", { "json": "always" }],
    "no-duplicate-imports": 0,
    "no-underscore-dangle": 0,
    "linebreak-style": 0,
    "import/no-unresolved": 0,
    "import/export": 2,
    "import/no-extraneous-dependencies": [
      2,
      {
        "devDependencies": true,
      }
    ],
    "import/order": [
      2,
      {
        "newlines-between": "always"
      }
    ],
    "import/imports-first": 2,
    "react/jsx-filename-extension": [1, { "extensions": [".js", ".jsx"] }],
    "react/sort-comp": [
      2, {
         "order": [
          "static-methods",
          "/props/",
          "/state/",
          "lifecycle",
          "everything-else",
          "render"
         ]
      }
    ]
  },
  "globals": { "fetch": false },
  "settings": {
    "import/core-modules": [
      "Dimensions",
      "ErrorUtils"
    ]
  },
  "plugins": [
    "react",
    "react-native"
  ]
}
